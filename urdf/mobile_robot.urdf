  <joint name="bar_to_base1" type="fixed">
    <origin xyz="0.114907 -0.0964181 0.05" rpy="0 -0 0" />
    <axis xyz="0 0 -1" />
    <parent link="base" />
    <child link="bar_1" />
  </joint>
  <joint name="bar_to_base2" type="fixed">
    <origin xyz="-0.114907 -0.0964181 0.05" rpy="0 -0 0" />
    <axis xyz="0 0 -1" />
    <parent link="base" />
    <child link="bar_3" />
  </joint>
  <joint name="bar_to_base3" type="fixed">
    <origin xyz="0.114907 0.0964181 0.05" rpy="0 -0 0" />
    <axis xyz="0 0 -1" />
    <parent link="base" />
    <child link="bar" />
  </joint>
  <joint name="bar_to_base4" type="fixed">
    <origin xyz="-0.114907 0.0964181 0.05" rpy="0 -0 0" />
    <axis xyz="0 0 -1" />
    <parent link="base" />
    <child link="bar_2" />
  </joint>
  <joint name="caster_socket_to_base" type="continuous">
    <origin xyz="0.12 -1.14925e-17 -0.01" rpy="0 -0 0" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.5" friction="0.05"/>
    <parent link="base" />
    <child link="caster_socket" />
  </joint>
  <joint name="caster_wheel_to_socket" type="continuous">
    <origin xyz="0 5e-07 -0.022" rpy="0 -0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.5" friction="0.05"/>
    <parent link="caster_socket" />
    <child link="caster_wheel" />
  </joint>
  <joint name="depth_camera_to_base" type="fixed">
    <origin xyz="-0.12 -1.20889e-16 0.1" rpy="0 0 -1.5708" />
    <axis xyz="0 0 -1" />
    <parent link="base" />
    <child link="depth_camera" />
  </joint>
  <joint name="hanging_node_to_root_joint" type="fixed">
    <origin xyz="-0.000225828 -0.000582711 -0.0756785" rpy="0 -0 0" />
    <axis xyz="0 0 1" />
    <parent link="root" />
    <child link="base" />
  </joint>
  <joint name="plate_to_bar" type="fixed">
    <origin xyz="-1.38778e-17 0 0.25" rpy="0 -0 0" />
