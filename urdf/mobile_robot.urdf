    <parent link="bar_3" />
    <child link="plate" />
  </joint>
  <joint name="rplidar_to_plate" type="fixed">
    <origin xyz="-0.00509333 0.0964181 0.015" rpy="0 0 0" />
    <axis xyz="0 0 -1" />
    <parent link="plate" />
    <child link="rplidar" />
  </joint>
  <joint name="wheel_left_to_base" type="continuous">
    <origin xyz="-0.06 -0.220358 0.05" rpy="1.5708 -0 -1.5708" />
    <axis xyz="1 0 0" />
    <dynamics damping="0.5" friction="0.05"/>
    <parent link="base" />
    <child link="wheel_left" />
  </joint>
  <joint name="wheel_right_to_base" type="continuous">
    <origin xyz="-0.06 0.220358 0.05" rpy="-1.5708 -0 1.5708" />
    <axis xyz="-1 0 0" />
    <dynamics damping="0.5" friction="0.05"/>
    <parent link="base" />
    <child link="wheel_right" />
  </joint>

  <gazebo reference="wheel_left">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="wheel_right">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="caster_wheel">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>


  <!-- Depth Camera controller plugin -->
  <gazebo reference="depth_camera">
    <sensor name="depth_camera" type="rgbd_camera">
      <pose>-0.120226 -0.0 0.0243214 0 0 -1.5708</pose>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>/camera</topic>
      <camera name="intel_realsense_d455">
        <horizontal_fov>1.50098</horizontal_fov>
        <lens>
          <intrinsics>
            <!-- fx = fy = width / ( 2 * tan (hfov / 2 ) ) -->
            <fx>343.159</fx>
            <fy>343.159</fy>
            <!-- cx = ( width - 1 ) / 2 -->
            <cx>319.5</cx>
            <!-- cy = ( height - 1 ) / 2 -->
            <cy>179.5</cy>
            <s>0</s>
          </intrinsics>
        </lens>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <image>
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>300</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- Lidar controller plugin -->
  <gazebo reference="rplidar">
    <sensor type="gpu_lidar" name="rplidar">
      <pose>0 0 0 0 0 3.14159265359</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <always_on>1</always_on>

      <topic>/scan</topic>

      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.284</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.10</min>
          <max>3.5</max>
          <resolution>0.015</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">

      <left_joint>wheel_left_to_base</left_joint>
      <right_joint>wheel_right_to_base</right_joint>

      <wheel_separation>0.440716</wheel_separation>
      <wheel_radius>0.099117</wheel_radius>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>root</child_frame_id>

      <odom_publish_frequency>30</odom_publish_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>wheel_left_to_base</joint_name>
      <joint_name>wheel_right_to_base</joint_name>
      <joint_name>caster_socket_to_base</joint_name>
      <joint_name>caster_wheel_to_socket</joint_name>
    </plugin>
  </gazebo>


</robot>
