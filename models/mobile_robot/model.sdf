    <!-- ============================================================ -->
    <!-- PLATE                                                         -->
    <!-- ============================================================ -->

    <link name="plate">

      <pose relative_to="bar_3">0 0 0.25 0 0 00</pose>

      <inertial>
        <pose>0.114907 0.0964181 -0.005 0 0 0</pose>
        <mass>1.56025</mass>
        <inertia>
          <ixx>0.0168214</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0163518</iyy>
          <iyz>0</iyz>
          <izz>0.0331472</izz>
        </inertia>
      </inertial>

      <visual name="plate_visual">
        <pose>0.114907 0.0964181 -0.01 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mobile_robot/meshes/plate.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.713726 0.760784 0.8 1</diffuse>
          <ambient>0.713726 0.760784 0.8 1</ambient>
        </material>
      </visual>

      <collision name="plate_collision">
        <pose>0.114907 0.0964181 -0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.374166 0.380716 0.010</size>
          </box>
        </geometry>
      </collision>

    </link>


    <!-- ============================================================ -->
    <!-- DEPTH CAMERA                                                  -->
    <!-- ============================================================ -->

    <link name="depth_camera">

      <pose relative_to="base">-0.12 0 0.1 0 0 -1.5708</pose>

      <inertial>
        <pose>-0.000224313 -0.00887366 0.0180682 0 0 0</pose>
        <mass>0.10278</mass>
        <inertia>
          <ixx>1.99451e-05</ixx>
          <ixy>-4.72461e-08</ixy>
          <ixz>9.49322e-08</ixz>
          <iyy>0.000125466</iyy>
          <iyz>2.64592e-06</iyz>
          <izz>0.000126152</izz>
        </inertia>
      </inertial>

      <visual name="depth_camera_visual">
        <pose>0.0000519288 -0.000172347 0.00608878 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mobile_robot/meshes/depth_camera.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.615686 0.811765 0.929412 1</diffuse>
          <ambient>0.615686 0.811765 0.929412 1</ambient>
        </material>
      </visual>

      <collision name="depth_camera_collision">
        <pose>-0.000338 -0.000040 0.011011 0 0 0</pose>
        <geometry>
          <box>
            <size>0.124 0.050425 0.0342</size>
          </box>
        </geometry>
      </collision>


      <!-- RGB-D SENSOR -->
      <sensor name="depth_camera" type="rgbd_camera">

        <pose>-0.120226 0 0.0243214 0 0 -1.5708</pose>

        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/camera</topic>

        <camera name="intel_realsense_d455">

          <horizontal_fov>1.50098</horizontal_fov>

          <lens>
            <intrinsics>
              <fx>343.159</fx>
              <fy>343.159</fy>
              <cx>319.5</cx>
              <cy>179.5</cy>
              <s>0</s>
            </intrinsics>
          </lens>

          <distortion>
            <k1>0</k1>
            <k2>0</k2>
            <k3>0</k3>
            <p1>0</p1>
            <p2>0</p2>
            <center>0.5 0.5</center>
          </distortion>

          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.01</near>
            <far>300</far>
          </clip>

          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
            <output>depths</output>
          </depth_camera>

          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>

        </camera>
      </sensor>

    </link>


    <!-- ============================================================ -->
    <!-- RPLIDAR                                                      -->
    <!-- ============================================================ -->

    <link name="rplidar">

      <pose relative_to="plate">-0.00509333 0.0964181 0.015 0 0 0</pose>

      <inertial>
        <pose>0.0100884 0.0000353251 0.0151831 0 0 0</pose>
        <mass>0.0997506</mass>
        <inertia>
          <ixx>4.28612e-05</ixx>
          <ixy>2.8632e-07</ixy>
          <ixz>1.36569e-05</ixz>
          <iyy>8.02911e-05</iyy>
          <iyz>-1.31345e-06</iyz>
          <izz>8.83408e-05</izz>
        </inertia>
      </inertial>

      <visual name="rplidar_visual">
        <pose>0.000083964 -0.000444572 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mobile_robot/meshes/rplidar.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.898039 0.913725 0.925490 1</diffuse>
          <ambient>0.898039 0.913725 0.925490 1</ambient>
        </material>
      </visual>

      <collision name="rplidar_collision">
        <pose>0.013251 -0.000034 0.013300 0 0 0</pose>
        <geometry>
          <box>
            <size>0.099 0.070926 0.0566</size>
          </box>
        </geometry>
      </collision>


      <!-- LIDAR SENSOR -->
      <sensor name="rplidar" type="gpu_lidar">

        <pose>0 0 0 0 0 3.14159265359</pose>

        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <always_on>true</always_on>

        <topic>/scan</topic>

        <ray>

          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.284</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.10</min>
            <max>3.5</max>
            <resolution>0.015</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>

        </ray>

      </sensor>

    </link>


    <!-- ============================================================ -->
    <!-- WHEELS                                                        -->
    <!-- ============================================================ -->

    <link name="wheel_left">

      <pose relative_to="base">-0.06 -0.220358 0.05 1.5708 0 -1.5708</pose>

      <inertial>
        <pose>0.0037479 0 0 0 0 0</pose>
        <mass>0.922424</mass>
        <inertia>
          <ixx>0.00462916</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00240533</iyy>
          <iyz>0</iyz>
          <izz>0.00240533</izz>
        </inertia>
      </inertial>

      <visual name="wheel_left_visual">
        <geometry>
          <mesh>
            <uri>model://mobile_robot/meshes/wheel.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.301961 0.301961 0.301961 1</diffuse>
          <ambient>0.301961 0.301961 0.301961 1</ambient>
        </material>
      </visual>

      <collision name="wheel_left_collision">
        <pose>0 0 0 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.099117</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>100.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

    </link>


    <link name="wheel_right">

      <pose relative_to="base">-0.06 0.220358 0.05 -1.5708 0 1.5708</pose>

      <inertial>
        <pose>0.0037479 0 0 0 0 0</pose>
        <mass>0.922424</mass>
        <inertia>
          <ixx>0.00462916</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00240533</iyy>
          <iyz>0</iyz>
          <izz>0.00240533</izz>
        </inertia>
      </inertial>

      <visual name="wheel_right_visual">
        <geometry>
          <mesh>
            <uri>model://mobile_robot/meshes/wheel.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.301961 0.301961 0.301961 1</diffuse>
          <ambient>0.301961 0.301961 0.301961 1</ambient>
        </material>
      </visual>

      <collision name="wheel_right_collision">
        <pose>0 0 0 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.099117</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>100.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

    </link>


    <!-- ============================================================ -->
    <!-- CASTER                                                        -->
    <!-- ============================================================ -->

    <link name="caster_socket">

      <pose relative_to="base">0.12 0 -0.01 0 0 0</pose>

      <inertial>
        <pose>0 0 -0.0137698 0 0 0</pose>
        <mass>0.0119725</mass>
        <inertia>
          <ixx>2.20545e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.71246e-06</iyy>
          <iyz>1.15412e-11</iyz>
          <izz>1.92329e-06</izz>
        </inertia>
      </inertial>

      <visual name="caster_socket_visual">
        <pose>0 0 -0.022 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mobile_robot/meshes/caster_socket.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.713726 0.760784 0.8 1</diffuse>
          <ambient>0.713726 0.760784 0.8 1</ambient>
        </material>
      </visual>

      <collision name="caster_socket_collision">
        <pose>0 0 0.007 0 0 0</pose>
        <geometry>
          <box>
            <size>0.026473 0.026474 0.03</size>
          </box>
        </geometry>
      </collision>

    </link>


    <link name="caster_wheel">

      <pose relative_to="caster_socket">0 0.0000005 -0.022 0 0 0</pose>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0130779</mass>
        <inertia>
          <ixx>1.09879e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.81484e-06</iyy>
          <iyz>0</iyz>
          <izz>1.09879e-06</izz>
        </inertia>
      </inertial>

      <visual name="caster_wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mobile_robot/meshes/caster_wheel.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.301961 0.301961 0.301961 1</diffuse>
          <ambient>0.301961 0.301961 0.301961 1</ambient>
        </material>
      </visual>

      <collision name="caster_wheel_collision">
        <pose>0 0 0 -1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.017991</radius>
            <length>0.032</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.3</mu>
              <mu2>0.3</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>


    <!-- ============================================================ -->
    <!-- JOINTS                                                         -->
    <!-- ============================================================ -->

    <joint name="hanging_node_to_root_joint" type="fixed">
      <parent>root</parent>
      <child>base</child>
      <pose>-0.000225828 -0.000582711 -0.0756785 0 0 0</pose>
    </joint>


    <joint name="depth_camera_to_base" type="fixed">
      <parent>base</parent>
      <child>depth_camera</child>
      <pose>-0.12 0 0.1 0 0 -1.5708</pose>
    </joint>


    <joint name="bar_to_base1" type="fixed">
      <parent>base</parent>
      <child>bar_1</child>
      <pose>0.114907 -0.0964181 0.05 0 0 0</pose>
    </joint>


    <joint name="bar_to_base2" type="fixed">
      <parent>base</parent>
      <child>bar_3</child>
      <pose>-0.114907 -0.0964181 0.05 0 0 0</pose>
    </joint>


    <joint name="bar_to_base3" type="fixed">
      <parent>base</parent>
      <child>bar</child>
      <pose>0.114907 0.0964181 0.05 0 0 0</pose>
    </joint>


    <joint name="bar_to_base4" type="fixed">
      <parent>base</parent>
      <child>bar_2</child>
      <pose>-0.114907 0.0964181 0.05 0 0 0</pose>
    </joint>


    <joint name="plate_to_bar" type="fixed">
      <parent>bar_3</parent>
      <child>plate</child>
      <pose>0 0 0.25 0 0 0</pose>
    </joint>


    <joint name="rplidar_to_plate" type="fixed">
      <parent>plate</parent>
      <child>rplidar</child>
      <pose>-0.00509333 0.0964181 0.015 0 0 0</pose>
    </joint>


    <!-- ============================================================ -->
    <!-- WHEEL JOINTS                                                   -->
    <!-- ============================================================ -->

    <joint name="wheel_left_to_base" type="revolute">

      <parent>base</parent>
      <child>wheel_left</child>

      <pose relative_to="base">-0.06 -0.220358 0.05 1.5708 0 -1.5708</pose>

      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>

    </joint>


    <joint name="wheel_right_to_base" type="revolute">

      <parent>base</parent>
      <child>wheel_right</child>

      <pose relative_to="base">-0.06 0.220358 0.05 -1.5708 0 1.5708</pose>

      <axis>
        <xyz>-1 0 0</xyz>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>

    </joint>


    <!-- ============================================================ -->
    <!-- CASTER JOINTS                                                  -->
    <!-- ============================================================ -->

    <joint name="caster_socket_to_base" type="revolute">

      <parent>base</parent>
      <child>caster_socket</child>

      <pose relative_to="base">0.12 0 -0.01 0 0 0</pose>

      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>

    </joint>


    <joint name="caster_wheel_to_socket" type="revolute">

      <parent>caster_socket</parent>
      <child>caster_wheel</child>

      <pose relative_to="base">0 0.0000005 -0.022 0 0 0</pose>

      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.5</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>

    </joint>

    <!-- ============================================================ -->
    <!-- DIFF DRIVE                                                     -->
    <!-- ============================================================ -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>wheel_left_to_base</left_joint>
      <right_joint>wheel_right_to_base</right_joint>

      <wheel_separation>0.440716</wheel_separation>
      <wheel_radius>0.099117</wheel_radius>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>root</child_frame_id>

      <odom_publish_frequency>30</odom_publish_frequency>

      <tf_topic>/tf</tf_topic>

    </plugin>


    <!-- ============================================================ -->
    <!-- JOINT STATE PUBLISHER                                         -->
    <!-- ============================================================ -->

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

