<?xml version="1.0" ?>
<sdf version="1.11">

  <model name="mobile_robot">

    <!-- ============================================================ -->
    <!-- ROOT                                                         -->
    <!-- ============================================================ -->

    <link name="root"/>


    <!-- ============================================================ -->
    <!-- BASE                                                         -->
    <!-- ============================================================ -->

    <link name="base">

      <pose>-0.000225828 -0.000582711 -0.0756785 0 0 0</pose>

      <inertial>
        <pose>-0.000219092 -0.000000173224 0.0499034 0 0 0</pose>
        <mass>15.1111</mass>
        <inertia>
          <ixx>0.171627</ixx>
          <ixy>-1.29454e-07</ixy>
          <ixz>4.93826e-05</ixz>
          <iyy>0.164228</iyy>
          <iyz>5.77083e-09</iyz>
          <izz>0.312047</izz>
        </inertia>
      </inertial>

      <visual name="base_visual">
        <geometry>
          <mesh>
            <uri>model://mobile_robot/meshes/base.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.713726 0.760784 0.8 1</diffuse>
          <ambient>0.713726 0.760784 0.8 1</ambient>
        </material>
      </visual>

      <collision name="base_collision">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry>
          <box>
            <size>0.374166 0.500716 0.110000</size>
          </box>
        </geometry>
      </collision>

    </link>


    <!-- ============================================================ -->
    <!-- BARS                                                         -->
    <!-- ============================================================ -->

    <link name="bar">

      <pose>0.114681172 0.095835389 -0.0256785 0 0 0</pose>

      <inertial>
        <pose>0 0 0.125 0 0 0</pose>
        <mass>0.0525726</mass>realtive_to="rplidar"
        <inertia>
          <ixx>0.000274555</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000274555</iyy>
          <iyz>0</iyz>
          <izz>1.4786e-06</izz>
        </inertia>
      </inertial>

      <visual name="bar_visual">
