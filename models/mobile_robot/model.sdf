            <size>0.015 0.014978 0.25</size>
          </box>
        </geometry>
      </collision>

    </link>


    <link name="bar_3">

      <pose>-0.115132828 -0.097000811 -0.0256785 0 0 0</pose>

      <inertial>
        <pose>0 0 0.125 0 0 0</pose>
        <mass>0.0525726</mass>
        <inertia>
          <ixx>0.000274555</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000274555</iyy>
          <iyz>0</iyz>
          <izz>1.4786e-06</izz>
        </inertia>
      </inertial>

      <visual name="bar_3_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mobile_robot/meshes/bar.stl</uri>
